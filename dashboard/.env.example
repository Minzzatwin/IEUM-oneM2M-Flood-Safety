# Copy this file to .env and adjust only if your environment differs.
# Dashboard reads these variables from the process environment.
IEUM_CSE_BASE_URL=https://example.invalid/mn-cse
IEUM_CSE_ORIGIN=CAdmin
IEUM_CSE_RVI=3
IEUM_VERIFY_TLS=false
IEUM_CSE_TIMEOUT=8

IEUM_MEC_SANDBOX_PREFIX=https://example.invalid
IEUM_MEC_PLATFORM=mep1
IEUM_MEC_APP_NAME=IEUM-Edge-Monitor
IEUM_MEC_APP_INSTANCE_ID=
IEUM_MEC_VERIFY_TLS=false
IEUM_MEC_TIMEOUT=8

# Optional: only set this if your Sandbox provides a bearer token for this API.
# Do not paste passwords, cookies, or session tokens into source code.
# IEUM_MEC_BEARER_TOKEN=
